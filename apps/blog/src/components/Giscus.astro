---
// Comments via giscus (GitHub Discussions-backed, https://giscus.app).
// Config generated from giscus.app against github.com/xvar/khaiminov.com's
// "Announcements" Discussions category.
const REPO = "xvar/khaiminov.com";
const REPO_ID = "R_kgDOUS6pXg";
const CATEGORY = "Announcements";
const CATEGORY_ID = "DIC_kwDOUS6pXs4DFvAP";
---

<div id="giscus-container">
  <script
    src="https://giscus.app/client.js"
    data-repo={REPO}
    data-repo-id={REPO_ID}
    data-category={CATEGORY}
    data-category-id={CATEGORY_ID}
    data-mapping="pathname"
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="preferred_color_scheme"
    data-lang="ru"
    crossorigin="anonymous"
    async
  />
</div>
