---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const boards = [
  { key: "pro", title: "PRO", sub: "Программирование, Android, работа" },
  { key: "life", title: "Life", sub: "Всё остальное" },
] as const;
---

<Base title="Блог Алексея Хайминов">
  <div class="board-wrap">
    <div class="boards">
      {
        boards.map((board) => {
          const boardPosts = posts.filter((post) => post.data.section === board.key);
          return (
            <div class={`board-card ${board.key}`}>
              <span class="tape" aria-hidden="true" />
              <div class="board-face">
                <span class="board-title">{board.title}</span>
                <span class="board-sub">{board.sub}</span>
                <div class="board-frame">
                  {boardPosts.length ? (
                    <ul class="row-list">
                      {boardPosts.map((post) => (
                        <li>
                          <a href={`/posts/${post.id}/`}>
                            <span class="date">
                              {post.data.date.toLocaleDateString("ru-RU", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                              })}
                            </span>
                            <span class="title">{post.data.title}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="empty">Пока нет статей</p>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Base>
